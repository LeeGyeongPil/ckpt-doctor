{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeeGyeongPil/ckpt-doctor/docs/report.schema.json",
  "title": "ckpt-doctor JSON report (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "tool", "target", "ok", "summary", "stats", "context", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"const": "ckpt-doctor"}, "version": {"type": "string"}}
    },
    "target": {"type": "string"},
    "ok": {"type": "boolean", "description": "true when there are no error-level findings"},
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "info"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "stats": {
      "type": "object",
      "required": ["bytes_read", "bytes_hashed", "files_checked", "elapsed_ms"],
      "properties": {
        "bytes_read": {"type": "integer", "minimum": 0, "description": "bytes read from disk for header checks"},
        "bytes_hashed": {"type": "integer", "minimum": 0, "description": "bytes read for --hash / --write-manifest"},
        "files_checked": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "number", "minimum": 0}
      }
    },
    "context": {
      "type": "object",
      "required": ["kind", "repo_id", "commit"],
      "properties": {
        "kind": {"enum": ["dir", "file", "index", "cache"]},
        "repo_id": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "layer", "path", "tensor", "message", "params", "fix"],
        "properties": {
          "code": {"type": "string", "pattern": "^CD[0-9]{3}$"},
          "severity": {"enum": ["error", "warning", "info"]},
          "layer": {"enum": ["input", "file", "index", "config", "cache", "hash"]},
          "path": {"type": ["string", "null"], "description": "relative to the checked folder (cache repo folder for caches)"},
          "tensor": {"type": ["string", "null"]},
          "message": {"type": "string", "description": "human text, depends on the output language"},
          "params": {"type": "object", "description": "language independent values behind the message"},
          "fix": {"type": ["string", "null"], "description": "shell command that repairs the problem, when one exists"}
        }
      }
    }
  }
}
